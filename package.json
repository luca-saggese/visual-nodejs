{
  "name": "visual-nodejs",
  "version": "0.1.0",
  "description": "A native desktop IDE for macOS that replicates the Visual Basic 6.0 experience for Node.js development.",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "macos": "export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer && react-native run-macos",
    "build": "export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer && react-native run-macos --configuration Release",
    "clean": "cd macos && rm -rf build Pods Podfile.lock && pod install",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "esbuild": "^0.17.0",
    "events": "^3.3.0",
    "monaco-editor": "^0.34.0",
    "react": "18.2.0",
    "react-native": "0.71.0",
    "react-native-crypto": "^2.2.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-macos": "0.71.0",
    "react-native-randombytes": "^3.6.2",
    "react-native-webview": "^11.26.0",
    "readable-stream": "^4.7.0",
    "stream-browserify": "^3.0.0",
    "ws": "^8.12.0",
    "zustand": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.73.7",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "react-test-renderer": "18.2.0"
  },
  "private": true
}
